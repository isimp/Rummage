<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the part of Rummage that needs no game: deciding what to take from which chest
       and where it goes in the inventory. src/Core has no Unity or BepInEx reference, so it
       builds here on its own.
       Run with: dotnet test tests/Rummage.Tests
       Not referenced by Rummage.csproj, so the plugin build never builds it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Rummage.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Core/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>

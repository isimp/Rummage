is_global = true

# The .NET code analysis rules Rummage turns off, each for what it misreads here. Every other rule
# runs and fails the build (BuildChecks.props).

# Unity's objects compare equal to null once destroyed, which flow analysis does not know: a
# null check on one that looks set is how a destroyed one is skipped, not dead code.
dotnet_diagnostic.CA1508.severity = none

# Unity calls its messages (Awake, Update) on the instance, by name; they cannot be static.
dotnet_diagnostic.CA1822.severity = none

# A BepInEx plugin's id is a dotted name ("isimp.Rummage"), not a GUID, whatever its parameter is
# called, and BepInEx names it GUID.
dotnet_diagnostic.CA2243.severity = none
dotnet_diagnostic.CA1720.severity = none

# The other mods are reached by reflection, and a member that is gone or changed is caught,
# logged once and left alone, whatever the exception.
dotnet_diagnostic.CA1031.severity = none
